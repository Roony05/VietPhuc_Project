# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# Thử đồ bằng CatVTON đã fine-tune Việt phục, chạy trên Modal. Thiếu 1 trong 3 dòng thì nút Ghép ảnh bị khóa.
# URL lấy sau khi chạy `modal deploy deploy/modal_app.py` trong project train_model_VTTon.
# KEY/SECRET tạo ở modal.com → Settings → Proxy Auth Tokens.
MODAL_TRYON_URL=""
MODAL_TRYON_KEY=""
MODAL_TRYON_SECRET=""

# HF_TOKEN (không bắt buộc): token Hugging Face quyền Read, dùng làm DỰ PHÒNG khi Modal lỗi (hết credits, hết lượt, máy chủ lỗi).
# App tự chuyển sang OOTDiffusion trên Hugging Face: model chung, không có nền trắng, quota GPU miễn phí ít.
HF_TOKEN=""
OOTD_SPACE="levihsu/OOTDiffusion"
